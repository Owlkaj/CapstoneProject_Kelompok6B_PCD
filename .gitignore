# ==============================================================================
# TomatCare — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Credentials (CRITICAL - DO NOT COMMIT TO PUBLIC REPO)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
*.env.backup
*.env.production

# Keep example files
!.env.example
!laravel/.env.example
!fastapi/.env.example

# ------------------------------------------------------------------------------
# 2. Python & Machine Learning Virtual Environments & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
*.pyc

# Virtual Environments
.venv/
*/.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ML/PyTorch Cache & Checkpoints
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Intermediate Training Checkpoints (avoid pushing >50MB binary checkpoints)
# ml/models/E01_best.pt
# ml/models/E02_best.pt
ml/models/E03_best.pt
ml/models/E*_best.pt

# Datasets (Raw bulk image files - manifest.csv and splits are kept)
ml/dataset/raw/
ml/dataset/processed/
ml/dataset/clean/
ml/dataset/augmented/

# Target-domain (field) dataset given by the user - large image corpus, keep local
dataset lapangan/
dataset-lapangan/

# Generated field manifests (large, reproducible from build_source_manifest.py)
ml/dataset/splits/manifest_field.csv
ml/dataset/splits/manifest_field2*.csv
ml/dataset/splits/manifest_field_*.csv
ml/dataset/splits/manifest_combined*.csv
ml/dataset/splits/manifest_pv.csv
ml/dataset/splits/_smoke.csv
ml/dataset/splits/_build_*.log

# Domain fine-tuning outputs (Skema B)
ml/models/model_field_only.pt
ml/models/model_field_mixed.pt
ml/models/_smoke_model.pt

# Model backups created by deploy_model.ps1
fastapi/models/*.bak_*
ml/models/*.bak_*

# ------------------------------------------------------------------------------
# 3. Laravel / PHP Dependencies & Generated Caches
# ------------------------------------------------------------------------------
laravel/vendor/
vendor/

# Laravel Storage & Framework Caches
laravel/storage/framework/cache/data/*
laravel/storage/framework/sessions/*
laravel/storage/framework/testing/*
laravel/storage/framework/views/*
laravel/storage/logs/*.log
laravel/storage/app/private/*
laravel/storage/app/public/*
laravel/public/storage
laravel/public/build
laravel/public/hot

# Keep directory structure .gitignore files inside storage
!laravel/storage/framework/cache/data/.gitignore
!laravel/storage/framework/sessions/.gitignore
!laravel/storage/framework/testing/.gitignore
!laravel/storage/framework/views/.gitignore
!laravel/storage/logs/.gitignore
!laravel/storage/app/.gitignore
!laravel/storage/app/private/.gitignore
!laravel/storage/app/public/.gitignore

# Laravel Bootstrap Cache
laravel/bootstrap/cache/*.php
!laravel/bootstrap/cache/.gitignore

# Database files
laravel/database/*.sqlite
laravel/database/*.sqlite-journal

# ------------------------------------------------------------------------------
# 4. Frontend & Node.js Dependencies
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
dist/

# ------------------------------------------------------------------------------
# 5. Local Tools, Machine Paths & Temporary Scratch Files
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp

# Graphify Knowledge Graph outputs
graphify-out/

# Planning, PRD & Internal UI specification files
PRD_Machine_Learning_Tomat_AgentReady_v3.md
*PRD*.md
PERUBAHAN.md
*PERUBAHAN*.md
ui.md
LAPORAN_ARSITEKTUR_DAN_SISTEM.md
*LAPORAN*.md

# Database hardening & SQL scripts
supabase_security_hardening.sql
*.sql

# Binary executables & Tunnel tools
*.exe
cloudflared*

# IDE & OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

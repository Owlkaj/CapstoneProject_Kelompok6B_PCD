MODEL_PATH=./models/final_model.pt
LABEL_MAPPING_PATH=./models/label_mapping.json
PREPROCESSING_CONFIG_PATH=./models/preprocessing.json
DEVICE=cpu
MAX_UPLOAD_SIZE_MB=10

# --- Leaf isolation preprocessing (domain-shift mitigation) ----------------
ENABLE_LEAF_PREPROCESSING=true
LEAF_SEGMENTATION_METHOD=auto
LEAF_TARGET_FILL=0.75
LEAF_BACKGROUND_GRAY=240
LEAF_COLOR_NORMALIZATION=true
LEAF_PREPROCESSING_POLICY=adaptive
# Set to a folder to save before/after images for A/B inspection (disabled when empty)
LEAF_DEBUG_DIR=

# --- Confidence gating (kalibrasi: ml/results/gating_calibration.json) ------
# Threshold terkalibrasi dari validation split group-disjoint (n=1.099, model_yolo3_grouped.pt):
#   benar  : confidence median 0.9989 (mean 0.9497)
#   salah  : confidence median 0.5572 (mean 0.5647)
# Pada t=0.60 -> menangkap 42/69 kesalahan (60.9%), hanya menahan 3.4% citra benar,
# akurasi dari yang diterima = 97.36% (97.54% pada full multi-signal gate).
ENABLE_CONFIDENCE_GATING=true
GATE_MIN_CONFIDENCE=0.60
GATE_MIN_MARGIN=0.10
GATE_MIN_SHARPNESS=25
GATE_MIN_BRIGHTNESS=30
GATE_MAX_BRIGHTNESS=226
GATE_MIN_RESOLUTION=96
